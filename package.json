{
  "name": "decoy-web",
  "version": "2.0.0",
  "description": "Marketing site for Decoy (trydecoy.com)",
  "scripts": {
    "build": "eleventy",
    "build:docs": "bash scripts/build-docs.sh",
    "build:all": "npm run clean && eleventy && npm run build:docs",
    "dev": "eleventy --serve --port 8099",
    "check": "node scripts/check-snippets.mjs && npm run build:all && node scripts/check-links.mjs dist && node scripts/check-claims.mjs dist",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louiskeep/decoy-web.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/louiskeep/decoy-web/issues"
  },
  "homepage": "https://github.com/louiskeep/decoy-web#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "geist": "^1.8.2",
    "gsap": "^3.15.0",
    "yaml": "^2.8.1"
  },
  "private": true,
  "type": "module"
}
