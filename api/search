report#decoy-report-diff","content":"EVIDENCE-SAFE: only aggregate counts are reported -- no raw values.\nSee `decoy report compare` for manifest-level (fingerprint) comparison.\nLOCAL ONLY: does not connect to the platform server."},"1678":{"id":"/docs/reference/cli/report-103","page_id":"/docs/reference/cli/report","tags":[],"type":"text","url":"/docs/reference/cli/report#decoy-report-diff","content":"**Usage**:"},"1679":{"id":"/docs/reference/cli/report-104","page_id":"/docs/reference/cli/report","tags":[],"type":"text","url":"/docs/reference/cli/report#decoy-report-diff","content":"**Arguments**:"},"1680":{"id":"/docs/reference/cli/report-105","page_id":"/docs/reference/cli/report","tags":[],"type":"text","url":"/docs/reference/cli/report#decoy-report-diff","content":"`RUN_ID_A`: Catalog run id (or prefix) for the first run.  \\[required]"},"1681":{"id":"/docs/reference/cli/report-106","page_id":"/docs/reference/cli/report","tags":[],"type":"text","url":"/docs/reference/cli/report#decoy-report-diff","content":"`RUN_ID_B`: Catalog run id (or prefix) for the second run.  \\[required]"},"1682":{"id":"/docs/reference/cli/report-107","page_id":"/docs/reference/cli/report","tags":[],"type":"text","url":"/docs/reference/cli/report#decoy-report-diff","content":"**Options**:"},"1683":{"id":"/docs/reference/cli/report-108","page_id":"/docs/reference/cli/report","tags":[],"type":"text","url":"/docs/reference/cli/report#decoy-report-diff","content":"`--json`: Emit structured JSON."},"1684":{"id":"/docs/reference/cli/report-109","page_id":"/docs/reference/cli/report","tags":[],"type":"text","url":"/docs/reference/cli/report#decoy-report-diff","content":"`-q, --quiet`: Suppress stdout."},"1685":{"id":"/docs/reference/cli/report-110","page_id":"/docs/reference/cli/report","tags":[],"type":"text","url":"/docs/reference/cli/report#decoy-report-diff","content":"`-v, --verbose`: Enable debug-level logs."},"1686":{"id":"/docs/reference/cli/report-111","page_id":"/docs/reference/cli