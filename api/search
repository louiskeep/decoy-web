37":5,"2838":5,"2839":5,"2840":5,"2841":5,"2842":5,"2843":5,"2844":5,"2845":5,"2846":4,"2847":4,"2848":5,"2849":5,"2850":5,"2851":4,"2852":4,"2853":4,"2854":5,"2855":5,"2856":5,"2857":5,"2858":5,"2859":5,"2860":5,"2861":5,"2862":5,"2863":5,"2864":5,"2865":5,"2866":5,"2867":5,"2868":5,"2869":5,"2870":5,"2871":5,"2872":5,"2873":3,"2874":3,"2875":4,"2876":4,"2877":4,"2878":4,"2879":3,"2880":4,"2881":4,"2882":4,"2883":4,"2884":4,"2885":4,"2886":4,"2887":5,"2888":5,"2889":5,"2890":4,"2891":4,"2892":4,"2893":5,"2894":5,"2895":5,"2896":5,"2897":5,"2898":5,"2899":5,"2900":5,"2901":5,"2902":5,"2903":5,"2904":5,"2905":5,"2906":5,"2907":5,"2908":5,"2909":5,"2910":5,"2911":5,"2912":5,"2913":5,"2914":5,"2915":5,"2916":5,"2917":5,"2918":4,"2919":4,"2920":5,"2921":5,"2922":4,"2923":4,"2924":5,"2925":5,"2926":5}}},"docs":{"docs":{"1":{"id":"/docs","page_id":"/docs","type":"page","content":"Decoy documentation","tags":[],"url":"/docs"},"2":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Data masking and synthetic data tooling for local files, YAML pipelines, and STORM-assisted review."},"3":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":[],"url":"/docs#what-ships-today","content":"What ships today"},"4":{"id":"/docs-2","page_id":"/docs","type":"heading","tags":[],"url":"/docs#where-to-go-next","content":"Where to go next"},"5":{"id":"/docs-3","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Decoy is a CLI-first toolkit for masking sensitive data and generating\nsynthetic replacements in local files and YAML-defined pipelines. You point it\nat a file or folder, it profiles the data, you review what it found, and you\nrun a pipeline that produces a masked or synthetic output you can inspect\nbefore it goes anywhere else."},"6":{"id":"/docs-4","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-ships-today","content":"23 masking strategies for field-level, reviewable transforms."},"7":{"id":"/docs-5","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-ships-today","content":"12 synthetic generation column types, plus statistical fitting for\nwhole-table generation."},"8":{"id":"/docs-6","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-ships-today","content":"34 synthetic value providers (names, emails, identifiers, and composites)\nfor the `faker` strategy, distinct from Decoy's I/O connectors\n(file, S3, GCS, SFTP)."},"9":{"id":"/docs-7","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-ships-today","content":"Every run is explicit: pipelines are plain YAML, strategies are picked per\nfield, and STORM profiling only ever suggests a strategy for you to confirm,\nit never classifies or applies anything on its own."},"10":{"id":"/docs-8","page_id":"/docs","tags":[],"type":"text","url":"/docs#where-to-go-next","content":"**Get started**: install the CLI and mask your first\nfile."},"11":{"id":"/docs-9","page_id":"/docs","tags":[],"type":"text","url":"/docs#where-to-go-next","content":"**Guides**: task recipes for masking, synthetic\ngeneration, foreign keys, subsetting, Parquet, and CI."},"12":{"id":"/docs-10","page_id":"/docs","tags":[],"type":"text","url":"/docs#where-to-go-next","content":"**Concepts**: how determinism, keys, STORM,\ndisguises, and differential privacy work."},"13":{"id":"/docs-11","page_id":"/docs","tags":[],"type":"text","url":"/docs#where-to-go-next","content":"**Reference**: the configuration schema, every\nmasking strategy and provider, connectors, and the CLI."},"14":{"id":"/docs-12","page_id":"/docs","tags":[],"type":"text","url":"/docs#where-to-go-next","content":"The `decoy` CLI is source-available under the Business Source License 1.1\n(BUSL-1.1)."},"15":{"id":"/docs/concepts/determinism","page_id":"/docs/concepts/determinism","type":"page","content":"Determinism","breadcrumbs":["Documentation","Concepts"],"tags":[],"url":"/docs/concepts/determinism"},"16":{"id":"/docs/concepts/determinism-0","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism","content":"The seed protocol behind reproducible masking and generation."},"17":{"id":"/docs/concepts/determinism-1","page_id":"/docs/concepts/determinism","type":"heading","tags":[],"url":"/docs/concepts/determinism#the-guarantee","content":"The guarantee"},"18":{"id":"/docs/concepts/determinism-2","page_id":"/docs/concepts/determinism","type":"heading","tags":[],"url":"/docs/concepts/determinism#two-levels-of-same-output","content":"Two levels of \"same output\""},"19":{"id":"/docs/concepts/determinism-3","page_id":"/docs/concepts/determinism","type":"heading","tags":[],"url":"/docs/concepts/determinism#what-is-deterministic","content":"What is deterministic"},"20":{"id":"/docs/concepts/determinism-4","page_id":"/docs/concepts/determinism","type":"heading","tags":[],"url":"/docs/concepts/determinism#what-is-not-deterministic","content":"What is not deterministic"},"21":{"id":"/docs/concepts/determinism-5","page_id":"/docs/concepts/determinism","type":"heading","tags":[],"url":"/docs/concepts/determinism#namespaces-scope-determinism","content":"Namespaces scope determinism"},"22":{"id":"/docs/concepts/determinism-6","page_id":"/docs/concepts/determinism","type":"heading","tags":[],"url":"/docs/concepts/determinism#renaming-a-column-changes-its-output","content":"Renaming a column changes its output"},"23":{"id":"/docs/concepts/determinism-7","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism","content":"Decoy is deterministic by design: the same inputs produce the same masked or\ngenerated output. That's what makes a masked dataset reproducible, makes\njoins stable across tables after masking, and makes a run auditable."},"24":{"id":"/docs/concepts/determinism-8","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#the-guarantee","content":"Every deterministic column routes through one primitive: derive a value from\na `(key material, namespace, source value)` triple using a keyed hash. The\nsame triple always produces the same output, across processes, across days,\nand across engine versions, as long as the underlying seed protocol version\nhasn't changed. From that primitive, the engine builds the higher-level\nmappings that pick a faker pool position, a categorical bucket, or a\ndomain-typed value."},"25":{"id":"/docs/concepts/determinism-9","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#two-levels-of-same-output","content":"There are two reproducibility scopes, and they answer different questions."},"26":{"id":"/docs/concepts/determinism-10","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#two-levels-of-same-output","content":"**Same seed, same machine.** Set `global_settings.seed` in the pipeline\nYAML. With a fixed seed, the same config plus the same input produces the\nsame output on repeated local runs. This is the baseline: run it twice,\nget the same file twice."},"27":{"id":"/docs/concepts/determinism-11","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#two-levels-of-same-output","content":"**Same key, any machine.** A bare seed reproduces per input, but it is not a\nconfidentiality secret and it does not by itself guarantee bitwise-identical\noutput across every keyed path on a different machine. For masking that is\nalso re-identification-safe and portable, configure a mask secret (see\nkeys and the vault); for generation, use\n`--master-key` with a `--key-label`. The same key and label always produce\nbitwise-identical output, wherever the run happens."},"28":{"id":"/docs/concepts/determinism-12","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#two-levels-of-same-output","content":"Masking and generation determinism are keyed independently. `job_seed`\ndrives reproducibility for generation and for the no-secret masking\nfallback. Actual re-identification-protecting masking draws from a separate\n`mask_key`, so setting one does not change the other."},"29":{"id":"/docs/concepts/determinism-13","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#what-is-deterministic","content":"Keyed masking strategies in deterministic mode: `faker`, `hash`, `fpe`,\n`date_shift`, `categorical`, `shuffle`. The same source value and the same\nnamespace always produce the same masked value."},"30":{"id":"/docs/concepts/determinism-14","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#what-is-deterministic","content":"Strategies that are deterministic by construction, because they're a pure\nfunction of their input and config: `bucketize`, `redact`, `text_redact`,\n`truncate`, `formula`."},"31":{"id":"/docs/concepts/determinism-15","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#what-is-deterministic","content":"Foreign-key remapping: a masked join stays byte-stable across runs."},"32":{"id":"/docs/concepts/determinism-16","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#what-is-deterministic","content":"Generation in seeded mode: the same seed produces the same synthetic\ntable."},"33":{"id":"/docs/concepts/determinism-17","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#what-is-not-deterministic","content":"Non-deterministic mode is opt-in for `faker`, `categorical`, and\n`shuffle`, which can draw from an unseeded source when you explicitly ask\nfor that. Two runs will differ; that's the point of turning it on."},"34":{"id":"/docs/concepts/determinism-18","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#what-is-not-deterministic","content":"Profiling without a seed falls back to system entropy for its sampling. On\na table larger than the sampling cap, that makes the profile, and\ntherefore anything compiled from it, non-deterministic. Always set a seed\nfor a reproducible profile; the CLI warns when one is missing."},"35":{"id":"/docs/concepts/determinism-19","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#what-is-not-deterministic","content":"Anything outside the keyed primitives: wall-clock timings, log ordering\nunder concurrency, and other run metadata are not part of the output\ncontract. Only the masked or generated table values are."},"36":{"id":"/docs/concepts/determinism-20","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#namespaces-scope-determinism","content":"The namespace is what ties columns together or keeps them apart. Two columns\nin the same namespace map identical source values to identical outputs,\nwhich is how a foreign key stays joined after both sides are masked. Two\ncolumns in different namespaces are independent even if they happen to share\nvalues. A keyed strategy without a namespace is a wiring error the engine\nrejects outright, rather than silently picking one for you."},"37":{"id":"/docs/concepts/determinism-21","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#renaming-a-column-changes-its-output","content":"Some keyed strategies (notably `fpe`) fold the column name itself into their\nderivation, so that two same-namespace columns with different names produce\nindependent ciphertexts instead of the same one. A side effect: renaming a\nmasked column and re-running the pipeline changes that column's masked\nvalues. If you need to unmask against the original run, do it before the\nrename, or treat the rename as a deliberate re-keying event."},"38":{"id":"/docs/concepts/determinism-22","page_id":"/docs/concepts/determinism","tags":[],"type":"text","url":"/docs/concepts/determinism#renaming-a-column-changes-its-output","content":"See `decoy explain substrate` for how the pandas and polars execution paths\nrelate to reproducibility, and\nkeys and the vault for how the mask secret\nand the seed fit together."},"39":{"id":"/docs/concepts/differential-privacy","page_id":"/docs/concepts/differential-privacy","type":"page","content":"Differential privacy in Decoy","breadcrumbs":["Documentation","Concepts"],"tags":[],"url":"/docs/concepts/differential-privacy"},"40":{"id":"/docs/concepts/differential-privacy-0","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy","content":"Marginal differential privacy on generated synthetic data using typed carriers and configurable epsilon/delta budgets."},"41":{"id":"/docs/concepts/differential-privacy-1","page_id":"/docs/concepts/differential-privacy","type":"heading","tags":[],"url":"/docs/concepts/differential-privacy#what-differential-privacy-does-in-decoy","content":"What differential privacy does in Decoy"},"42":{"id":"/docs/concepts/differential-privacy-2","page_id":"/docs/concepts/differential-privacy","type":"heading","tags":[],"url":"/docs/concepts/differential-privacy#when-to-use-it","content":"When to use it"},"43":{"id":"/docs/concepts/differential-privacy-3","page_id":"/docs/concepts/differential-privacy","type":"heading","tags":[],"url":"/docs/concepts/differential-privacy#epsilon-and-delta-the-privacy-budget","content":"Epsilon and delta: the privacy budget"},"44":{"id":"/docs/concepts/differential-privacy-4","page_id":"/docs/concepts/differential-privacy","type":"heading","tags":[],"url":"/docs/concepts/differential-privacy#configuration","content":"Configuration"},"45":{"id":"/docs/concepts/differential-privacy-5","page_id":"/docs/concepts/differential-privacy","type":"heading","tags":[],"url":"/docs/concepts/differential-privacy#what-the-guarantee-covers","content":"What the guarantee covers"},"46":{"id":"/docs/concepts/differential-privacy-6","page_id":"/docs/concepts/differential-privacy","type":"heading","tags":[],"url":"/docs/concepts/differential-privacy#what-the-guarantee-does-not-mean","content":"What the guarantee does not mean"},"47":{"id":"/docs/concepts/differential-privacy-7","page_id":"/docs/concepts/differential-privacy","type":"heading","tags":[],"url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"Comparing to non-DP generation"},"48":{"id":"/docs/concepts/differential-privacy-8","page_id":"/docs/concepts/differential-privacy","type":"heading","tags":[],"url":"/docs/concepts/differential-privacy#when-fidelity-drops","content":"When fidelity drops"},"49":{"id":"/docs/concepts/differential-privacy-9","page_id":"/docs/concepts/differential-privacy","type":"heading","tags":[],"url":"/docs/concepts/differential-privacy#usage-in-practice","content":"Usage in practice"},"50":{"id":"/docs/concepts/differential-privacy-10","page_id":"/docs/concepts/differential-privacy","type":"heading","tags":[],"url":"/docs/concepts/differential-privacy#see-also","content":"See also"},"51":{"id":"/docs/concepts/differential-privacy-11","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy","content":"Decoy supports **marginal differential privacy** when you generate synthetic data. This page explains what that means, what it guarantees, and what it does not cover."},"52":{"id":"/docs/concepts/differential-privacy-12","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-differential-privacy-does-in-decoy","content":"When you run `decoy fit --epsilon` (or set `global_settings.dp` in a pipeline), the engine:"},"53":{"id":"/docs/concepts/differential-privacy-13","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-differential-privacy-does-in-decoy","content":"Reads your source data once"},"54":{"id":"/docs/concepts/differential-privacy-14","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-differential-privacy-does-in-decoy","content":"Measures a distribution snapshot for each declared typed carrier (numeric, categorical, or flag columns) with noise added to protect column statistics"},"55":{"id":"/docs/concepts/differential-privacy-15","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-differential-privacy-does-in-decoy","content":"Generates synthetic rows by sampling from the noisy snapshot"},"56":{"id":"/docs/concepts/differential-privacy-16","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-differential-privacy-does-in-decoy","content":"Provides a formal privacy guarantee under the *add-or-remove-one-row* model"},"57":{"id":"/docs/concepts/differential-privacy-17","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-differential-privacy-does-in-decoy","content":"The budget `(epsilon, delta)` bounds the per-column marginal snapshot: the measured statistics are indistinguishable, up to that budget, between two runs on datasets that differ by one row. Decoy measures each column's marginal independently; it does not account for a joint guarantee over the whole synthetic table, and the generated rows are a deterministic sample from the noisy snapshot. See Security, privacy, and compliance limits for exactly what the generated output does and does not inherit."},"58":{"id":"/docs/concepts/differential-privacy-18","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-differential-privacy-does-in-decoy","content":"**This is not obfuscation or anonymization.** Differential privacy is a mathematical guarantee on the measured statistics. It is the right tool when you want a budgeted, measured bound on what a column's published distribution can reveal about any one row."},"59":{"id":"/docs/concepts/differential-privacy-19","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-to-use-it","content":"Use differential privacy if:"},"60":{"id":"/docs/concepts/differential-privacy-20","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-to-use-it","content":"You need to generate synthetic data and publish it or share it externally"},"61":{"id":"/docs/concepts/differential-privacy-21","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-to-use-it","content":"You want a formal privacy guarantee, not just security through obscurity"},"62":{"id":"/docs/concepts/differential-privacy-22","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-to-use-it","content":"Your data contains sensitive attributes you want to protect"},"63":{"id":"/docs/concepts/differential-privacy-23","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-to-use-it","content":"Do not rely on Decoy's DP for:"},"64":{"id":"/docs/concepts/differential-privacy-24","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-to-use-it","content":"Masked output (masking carries no DP guarantee)"},"65":{"id":"/docs/concepts/differential-privacy-25","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-to-use-it","content":"Healthcare free-text or dates (DP does not cover these column types)"},"66":{"id":"/docs/concepts/differential-privacy-26","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-to-use-it","content":"Perfectly preserving the original distribution (DP adds noise, reducing fidelity)"},"67":{"id":"/docs/concepts/differential-privacy-27","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#epsilon-and-delta-the-privacy-budget","content":"Your privacy guarantee is parameterized by two numbers:"},"68":{"id":"/docs/concepts/differential-privacy-28","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#epsilon-and-delta-the-privacy-budget","content":"**Epsilon (ε)**: Controls privacy loss per column. Think of it as \"how much noise should we add?\" Smaller epsilon means more noise (stronger privacy), higher epsilon means less noise (better fidelity). Typical values range from 0.1 to 10."},"69":{"id":"/docs/concepts/differential-privacy-29","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#epsilon-and-delta-the-privacy-budget","content":"ε = 0.1: very strong privacy, but low fidelity (noisy output)"},"70":{"id":"/docs/concepts/differential-privacy-30","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#epsilon-and-delta-the-privacy-budget","content":"ε = 1: moderate privacy with reasonable fidelity (common choice)"},"71":{"id":"/docs/concepts/differential-privacy-31","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#epsilon-and-delta-the-privacy-budget","content":"ε = 10: weak privacy, high fidelity"},"72":{"id":"/docs/concepts/differential-privacy-32","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#epsilon-and-delta-the-privacy-budget","content":"**Delta (δ)**: The failure probability. A small constant (typically 1e-6 or 1e-9), delta represents the chance that the guarantee is violated. In most cases, use a delta smaller than 1/n, where n is your dataset size."},"73":{"id":"/docs/concepts/differential-privacy-33","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#epsilon-and-delta-the-privacy-budget","content":"When you generate multiple columns, the privacy budget **composes**. Releasing k columns with a total budget of epsilon spends roughly `(k + 1) * epsilon` across the entire release. This is the primary limit on DP-supported workloads."},"74":{"id":"/docs/concepts/differential-privacy-34","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#configuration","content":"In your pipeline YAML:"},"75":{"id":"/docs/concepts/differential-privacy-35","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#configuration","content":"Key points:"},"76":{"id":"/docs/concepts/differential-privacy-36","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#configuration","content":"**`column_schema` is required.** You declare each typed carrier (numeric, categorical, or flag column) you want DP protection for, with its type and domain (min/max for numeric, category list for categorical). Inferring the domain from the data itself leaks information at zero budget."},"77":{"id":"/docs/concepts/differential-privacy-37","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#configuration","content":"**`allow_real_categories: false`** prevents the engine from releasing actual category names from your data. When set to false, high-frequency categories are generalized."},"78":{"id":"/docs/concepts/differential-privacy-38","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#configuration","content":"**Numeric and categorical only.** Dates, free text, and complex types are not supported under DP; use non-DP generation types for these."},"79":{"id":"/docs/concepts/differential-privacy-39","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-covers","content":"The formal guarantee applies to:"},"80":{"id":"/docs/concepts/differential-privacy-40","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-covers","content":"Per-column marginal distributions (histograms and counts)"},"81":{"id":"/docs/concepts/differential-privacy-41","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-covers","content":"Synthetic rows generated from the noisy snapshot"},"82":{"id":"/docs/concepts/differential-privacy-42","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-covers","content":"The guarantee does **not** cover:"},"83":{"id":"/docs/concepts/differential-privacy-43","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-covers","content":"Column names or schema (considered public metadata)"},"84":{"id":"/docs/concepts/differential-privacy-44","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-covers","content":"Foreign key relationships (public structural info)"},"85":{"id":"/docs/concepts/differential-privacy-45","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-covers","content":"Masked output (masking is outside the DP boundary)"},"86":{"id":"/docs/concepts/differential-privacy-46","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-covers","content":"Conditional generation (`condition_on` is rejected under DP because joint distributions are not private)"},"87":{"id":"/docs/concepts/differential-privacy-47","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-covers","content":"Dates and free text (rejected at compile time)"},"88":{"id":"/docs/concepts/differential-privacy-48","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-does-not-mean","content":"**DP does not mean zero information leakage.** It means bounded leakage. An attacker with the synthetic data learns something, but only up to the epsilon budget."},"89":{"id":"/docs/concepts/differential-privacy-49","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-does-not-mean","content":"**DP is not anonymization.** Privacy and utility are a tradeoff. Adding noise makes the output safer to publish but less faithful to the source. You still need to review the synthetic output and decide if it is safe for your use case."},"90":{"id":"/docs/concepts/differential-privacy-50","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#what-the-guarantee-does-not-mean","content":"**DP in Decoy measures by row, not person.** If a person in your source has fifty rows (claim records, lab results), removing one person removes fifty rows. The DP guarantee covers removing one row, not one person. For healthcare multi-record scenarios, this means the per-person privacy is weaker than the per-row epsilon suggests: removing a fifty-row person is a fifty-row change, far beyond the one-row guarantee. Decoy's configuration treats rows as the unit."},"91":{"id":"/docs/concepts/differential-privacy-51","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"Without `global_settings.dp`:"},"92":{"id":"/docs/concepts/differential-privacy-52","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"Snapshot columns sample from observed distributions without noise"},"93":{"id":"/docs/concepts/differential-privacy-53","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"No formal privacy guarantee, but generally better fidelity"},"94":{"id":"/docs/concepts/differential-privacy-54","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"Faster (no measurement overhead)"},"95":{"id":"/docs/concepts/differential-privacy-55","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"With `global_settings.dp`:"},"96":{"id":"/docs/concepts/differential-privacy-56","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"Snapshot columns sample from noisy distributions"},"97":{"id":"/docs/concepts/differential-privacy-57","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"Formal epsilon/delta guarantee"},"98":{"id":"/docs/concepts/differential-privacy-58","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"Lower expected fidelity (noise trades accuracy for privacy)"},"99":{"id":"/docs/concepts/differential-privacy-59","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"Slower (OpenDP measurement and post-processing adds time)"},"100":{"id":"/docs/concepts/differential-privacy-60","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#comparing-to-non-dp-generation","content":"A recurring misconception: &#x2A;*DP is not what makes output resemble the source.** Fitting does. DP is what makes the resemblance safe to publish."},"101":{"id":"/docs/concepts/differential-privacy-61","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-fidelity-drops","content":"Turning on DP normally reduces expected fidelity compared to the same fit without DP. The main reasons:"},"102":{"id":"/docs/concepts/differential-privacy-62","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-fidelity-drops","content":"Noise is added to histogram counts and quantiles to achieve the privacy guarantee"},"103":{"id":"/docs/concepts/differential-privacy-63","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-fidelity-drops","content":"Categorical tail mass (rare values) is redistributed or collapsed into an `__other__` category"},"104":{"id":"/docs/concepts/differential-privacy-64","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-fidelity-drops","content":"Low epsilon (more noise) pushes the output further from the source distribution"},"105":{"id":"/docs/concepts/differential-privacy-65","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-fidelity-drops","content":"To improve fidelity under DP, you can:"},"106":{"id":"/docs/concepts/differential-privacy-66","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-fidelity-drops","content":"Increase epsilon (weaker privacy guarantee, better fidelity)"},"107":{"id":"/docs/concepts/differential-privacy-67","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-fidelity-drops","content":"Increase delta (higher failure probability, better fidelity)"},"108":{"id":"/docs/concepts/differential-privacy-68","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-fidelity-drops","content":"Reduce the number of columns (lower composition cost)"},"109":{"id":"/docs/concepts/differential-privacy-69","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#when-fidelity-drops","content":"Simplify the domains (fewer categories to measure)"},"110":{"id":"/docs/concepts/differential-privacy-70","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#usage-in-practice","content":"**Plan your privacy budget.** Decide on epsilon and delta based on your sensitivity and use case. (Consult your privacy or security team if this is a high-stakes release.)"},"111":{"id":"/docs/concepts/differential-privacy-71","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#usage-in-practice","content":"**Declare your column schema.** List every column you want DP protection for, its type, and its domain."},"112":{"id":"/docs/concepts/differential-privacy-72","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#usage-in-practice","content":"**Run the fit and generation.** The engine measures the snapshot with noise, then generates synthetic data."},"113":{"id":"/docs/concepts/differential-privacy-73","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#usage-in-practice","content":"**Review and test.** Check that the synthetic output is useful for your downstream task (analysis, testing, training models). DP adds noise, so utility may be lower than non-DP generation."},"114":{"id":"/docs/concepts/differential-privacy-74","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#usage-in-practice","content":"**Publish with confidence.** Once you are satisfied with fidelity, the synthetic data carries a formal privacy guarantee."},"115":{"id":"/docs/concepts/differential-privacy-75","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#see-also","content":"Generate synthetic data: full recipe for synthetic generation"},"116":{"id":"/docs/concepts/differential-privacy-76","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#see-also","content":"Use differential privacy: step-by-step example with YAML"},"117":{"id":"/docs/concepts/differential-privacy-77","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#see-also","content":"Determinism: how seeds and keys affect reproducibility under DP"},"118":{"id":"/docs/concepts/differential-privacy-78","page_id":"/docs/concepts/differential-privacy","tags":[],"type":"text","url":"/docs/concepts/differential-privacy#see-also","content":"Security, privacy, and compliance limits: honest boundaries of all Decoy guarantees"},"119":{"id":"/docs/concepts/disguises","page_id":"/docs/concepts/disguises","type":"page","content":"Disguises","breadcrumbs":["Documentation","Concepts"],"tags":[],"url":"/docs/concepts/disguises"},"120":{"id":"/docs/concepts/disguises-0","page_id":"/docs/concepts/disguises","tags":[],"type":"text","url":"/docs/concepts/disguises","content":"What a Disguise is, and what it is not."},"121":{"id":"/docs/concepts/disguises-1","page_id":"/docs/concepts/disguises","type":"heading","tags":[],"url":"/docs/concepts/disguises#what-a-disguise-is","content":"What a Disguise is"},"122":{"id":"/docs/concepts/disguises-2","page_id":"/docs/concepts/disguises","type":"heading","tags":[],"url":"/docs/concepts/disguises#what-a-disguise-is-not","content":"What a Disguise is not"},"123":{"id":"/docs/concepts/disguises-3","page_id":"/docs/concepts/disguises","type":"heading","tags":[],"url":"/docs/concepts/disguises#why-bundles-exist-at-all","content":"Why bundles exist at all"},"124":{"id":"/docs/concepts/disguises-4","page_id":"/docs/concepts/disguises","tags":[],"type":"text","url":"/docs/concepts/disguises","content":"A Disguise is a named, regulation-shaped bundle of masking defaults. It gives\nyou a starting pipeline for a common compliance shape, such as HIPAA Safe\nHarbor identifiers or PCI cardholder data, instead of a blank YAML file."},"125":{"id":"/docs/concepts/disguises-5","page_id":"/docs/concepts/disguises","tags":[],"type":"text","url":"/docs/concepts/disguises#what-a-disguise-is","content":"Each Disguise is a template: a set of column-pattern-to-strategy defaults\ntuned for a specific regulation or use case. `decoy templates show hipaa`\ndumps a ready-to-edit pipeline that maps the identifier categories a HIPAA\nSafe Harbor review commonly cares about (names, dates, geographic\nsubdivisions, medical record numbers, and the rest) onto strategies like\n`faker`, `date_shift`, `fpe`, and `redact`. You pick the Disguise, inspect\nthe generated YAML, and tune it to your actual columns before running it."},"126":{"id":"/docs/concepts/disguises-6","page_id":"/docs/concepts/disguises","tags":[],"type":"text","url":"/docs/concepts/disguises#what-a-disguise-is","content":"Bundled starting points ship today for a generic default, HIPAA, PCI DSS, and\nGDPR shapes, alongside a bare-bones minimal template. Browse what's\navailable with `decoy templates list` and preview one with\n`decoy templates show <name>`."},"127":{"id":"/docs/concepts/disguises-7","page_id":"/docs/concepts/disguises","tags":[],"type":"text","url":"/docs/concepts/disguises#what-a-disguise-is-not","content":"**It is not automatic classification.** A Disguise does not scan your data\nand decide which template applies, and it does not apply itself. You choose\na Disguise the same way you choose any other starting template: by name,\nbecause you know your data is HIPAA-shaped or PCI-shaped. This is the same\ndisguises-as-presets stance that shapes STORM (see\nSTORM): the tool surfaces defaults and findings, and\na person decides what to run."},"128":{"id":"/docs/concepts/disguises-8","page_id":"/docs/concepts/disguises","tags":[],"type":"text","url":"/docs/concepts/disguises#what-a-disguise-is-not","content":"**It is not a compliance certification.** A Disguise named `hipaa` encodes\none engineering-team's reasonable reading of a common identifier set. Running\nit does not, by itself, make a dataset HIPAA-compliant, GDPR-compliant, or\ncompliant with any other regime. Whether a masked dataset satisfies a\nregulation as applied to your actual data is a determination for you and\nyour counsel, not a claim this tool makes."},"129":{"id":"/docs/concepts/disguises-9","page_id":"/docs/concepts/disguises","tags":[],"type":"text","url":"/docs/concepts/disguises#what-a-disguise-is-not","content":"**It is not a fixed, uneditable bundle.** Every Disguise resolves to plain\npipeline YAML. Nothing stops you from deleting a column entry your data\ndoesn't have, swapping a strategy, or adding columns the template didn't\nanticipate. Treat the output of `decoy templates show` as a draft, not a\nfinal answer."},"130":{"id":"/docs/concepts/disguises-10","page_id":"/docs/concepts/disguises","tags":[],"type":"text","url":"/docs/concepts/disguises#why-bundles-exist-at-all","content":"Writing a masking pipeline column by column from scratch is slow, and it's\neasy to forget an identifier category a regulation actually cares about. A\nDisguise front-loads that knowledge into a template so the first draft of\nyour pipeline already covers the common cases; you're editing toward\ncorrectness for your data, not starting from an empty file."},"131":{"id":"/docs/concepts/disguises-11","page_id":"/docs/concepts/disguises","tags":[],"type":"text","url":"/docs/concepts/disguises#why-bundles-exist-at-all","content":"See `decoy explain disguises` for the command-line summary, and\nhow to scan for PII for the recipe that pairs a\nSTORM scan with picking a Disguise."},"132":{"id":"/docs/concepts/keys-and-vault","page_id":"/docs/concepts/keys-and-vault","type":"page","content":"Keys and the vault","breadcrumbs":["Documentation","Concepts"],"tags":[],"url":"/docs/concepts/keys-and-vault"},"133":{"id":"/docs/concepts/keys-and-vault-0","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault","content":"How Decoy sources the secret behind masking, and how the token vault makes a one-way mask reversible."},"134":{"id":"/docs/concepts/keys-and-vault-1","page_id":"/docs/concepts/keys-and-vault","type":"heading","tags":[],"url":"/docs/concepts/keys-and-vault#two-separate-keys","content":"Two separate keys"},"135":{"id":"/docs/concepts/keys-and-vault-2","page_id":"/docs/concepts/keys-and-vault","type":"heading","tags":[],"url":"/docs/concepts/keys-and-vault#why-masking-has-its-own-key","content":"Why masking has its own key"},"136":{"id":"/docs/concepts/keys-and-vault-3","page_id":"/docs/concepts/keys-and-vault","type":"heading","tags":[],"url":"/docs/concepts/keys-and-vault#the-unmask-model","content":"The unmask model"},"137":{"id":"/docs/concepts/keys-and-vault-4","page_id":"/docs/concepts/keys-and-vault","type":"heading","tags":[],"url":"/docs/concepts/keys-and-vault#handling-rules","content":"Handling rules"},"138":{"id":"/docs/concepts/keys-and-vault-5","page_id":"/docs/concepts/keys-and-vault","type":"heading","tags":[],"url":"/docs/concepts/keys-and-vault#what-this-is-not","content":"What this is not"},"139":{"id":"/docs/concepts/keys-and-vault-6","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault","content":"Decoy has two independent keyed-determinism mechanisms. They do not share a\nsecret, and setting one has no effect on the other."},"140":{"id":"/docs/concepts/keys-and-vault-7","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#two-separate-keys","content":"**Synthetic generation** (`generate_columns:` tables) is deterministic by\ndefault: the same seed produces the same generated output within one run,\nbut that output is not portable across machines. Passing `--master-key`\n(a 32-byte hex value) plus `--key-label` makes generation portable: the same\nkey and label produce bitwise-identical generated output anywhere, and a\ndifferent label produces different output because the label is itself a\nnamespace."},"141":{"id":"/docs/concepts/keys-and-vault-8","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#two-separate-keys","content":"**Masking** (`mask:` strategies) is keyed separately, off a `mask_secret_ref`\nyou configure in the pipeline YAML or pass with `--mask-secret`:"},"142":{"id":"/docs/concepts/keys-and-vault-9","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#two-separate-keys","content":"Keyed masking strategies (`fpe`, `hash`, `date_shift`, and others) draw a\n`mask_key` from this reference, never from `--master-key` and never from the\nplain seed. The engine resolves the reference from the named environment\nvariable or file at run time, decodes it to raw bytes, and never logs or\nserializes the secret itself."},"143":{"id":"/docs/concepts/keys-and-vault-10","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#why-masking-has-its-own-key","content":"The run seed makes output reproducible, but a seed is not a confidentiality\nsecret: it is often stored in the same config file as the rest of the\npipeline. If keyed masking derived its protection from the seed alone, anyone\nwho could read the config could reconstruct the masking. Splitting the two\nmeans the pipeline shape (which columns get which strategy) can be reviewed\nand version-controlled openly, while the thing that actually protects\nre-identification is a secret you hold separately."},"144":{"id":"/docs/concepts/keys-and-vault-11","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#why-masking-has-its-own-key","content":"Before a mask secret is configured, keyed masking still runs so you can\niterate locally, falling back to the run seed. That fallback output is\nreproducible but not re-identification-safe: anyone holding the config can\nreproduce the mapping. A real deployment should configure a mask secret. At\ngeneral availability, a keyed strategy with no resolved secret is rejected\noutright rather than silently falling back, so a production run can't ship\nunkeyed by accident."},"145":{"id":"/docs/concepts/keys-and-vault-12","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#the-unmask-model","content":"Some strategies are reversible from the config alone. `fpe` (format-preserving\nencryption) is a bijection: the same key that produced a masked value can run\nit backward, so `decoy unmask` on an `fpe` column needs only the same\nmask secret and namespace that produced it, not a stored mapping."},"146":{"id":"/docs/concepts/keys-and-vault-13","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#the-unmask-model","content":"Most strategies are one-way (`faker`, `hash`, `redact`, and the rest). To make\na one-way column reversible, mark it `vault: true` in the YAML and pass a\nvault path on the run:"},"147":{"id":"/docs/concepts/keys-and-vault-14","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#the-unmask-model","content":"The vault is an encrypted file recording each vaulted column's\nsource-to-masked mapping at mask time. Recover originals with:"},"148":{"id":"/docs/concepts/keys-and-vault-15","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#the-unmask-model","content":"The vault's own encryption key derives from the same `mask_key` as the rest\nof the run, so unlocking the vault requires the mask secret (or, in the\nno-secret fallback, the seed) that produced it. Vault creation is opt-in\ntwice over: a column has to declare `vault: true`, and the operator has to\npass `--vault PATH`. A masking run never writes a vault otherwise."},"149":{"id":"/docs/concepts/keys-and-vault-16","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#handling-rules","content":"Store the vault and the masked output separately. The masked output is the\nartifact that's safe to share; the vault is the thing that un-shares it."},"150":{"id":"/docs/concepts/keys-and-vault-17","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#handling-rules","content":"The vault grows with the data it protects, unlike a key or a seed. Treat it\nwith the same handling the source data itself requires."},"151":{"id":"/docs/concepts/keys-and-vault-18","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#handling-rules","content":"`vault: true` is rejected on `fpe` columns, since those are already\nreversible from the config and key alone; a vault entry would be redundant."},"152":{"id":"/docs/concepts/keys-and-vault-19","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#handling-rules","content":"Pooled strategies can map two different source values to the same masked\nvalue. Those ambiguous entries are dropped at write time rather than\nguessed at on unmask, so a round trip is exact only for collision-free\nstrategies such as `hash` under a namespace."},"153":{"id":"/docs/concepts/keys-and-vault-20","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#what-this-is-not","content":"Neither the master key nor the mask secret is a key-management service.\nDecoy reads bytes from an environment variable or a file reference; rotation\npolicy, per-tenant secret storage, and audit trails around who accessed a\nkey are the deploying organization's responsibility, not something the CLI\nprovides."},"154":{"id":"/docs/concepts/keys-and-vault-21","page_id":"/docs/concepts/keys-and-vault","tags":[],"type":"text","url":"/docs/concepts/keys-and-vault#what-this-is-not","content":"See `decoy explain keys` and `decoy explain vault` for the command-line\nwalkthrough, and determinism for how these keys\nfit into the seed protocol."},"155":{"id":"/docs/concepts/storm","page_id":"/docs/concepts/storm","type":"page","content":"STORM","breadcrumbs":["Documentation","Concepts"],"tags":[],"url":"/docs/concepts/storm"},"156":{"id":"/docs/concepts/storm-0","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm","content":"What STORM does, and why it suggests rather than decides."},"157":{"id":"/docs/concepts/storm-1","page_id":"/docs/concepts/storm","type":"heading","tags":[],"url":"/docs/concepts/storm#what-a-storm-scan-reports","content":"What a STORM scan reports"},"158":{"id":"/docs/concepts/storm-2","page_id":"/docs/concepts/storm","type":"heading","tags":[],"url":"/docs/concepts/storm#suggestions-not-classification","content":"Suggestions, not classification"},"159":{"id":"/docs/concepts/storm-3","page_id":"/docs/concepts/storm","type":"heading","tags":[],"url":"/docs/concepts/storm#how-a-finding-becomes-a-choice","content":"How a finding becomes a choice"},"160":{"id":"/docs/concepts/storm-4","page_id":"/docs/concepts/storm","type":"heading","tags":[],"url":"/docs/concepts/storm#why-this-matters-for-trust","content":"Why this matters for trust"},"161":{"id":"/docs/concepts/storm-5","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm","content":"STORM scans a dataset before you write a masking pipeline and produces a\nprofile: what's in the data, and where the risk is concentrated."},"162":{"id":"/docs/concepts/storm-6","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#what-a-storm-scan-reports","content":"Run `decoy storm analyze` against a file and you get, per column:"},"163":{"id":"/docs/concepts/storm-7","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#what-a-storm-scan-reports","content":"Inferred type, cardinality, null fraction, and top values."},"164":{"id":"/docs/concepts/storm-8","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#what-a-storm-scan-reports","content":"PII detector hits, from pattern and named-entity signals."},"165":{"id":"/docs/concepts/storm-9","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#what-a-storm-scan-reports","content":"Sentinel-value flags: the `999`s, `99/99/9999`s, and other placeholder\nliterals that pollute real statistics if left in."},"166":{"id":"/docs/concepts/storm-10","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#what-a-storm-scan-reports","content":"Quasi-identifier groups: sets of columns that, combined, uniquely identify\na row even though no single column does."},"167":{"id":"/docs/concepts/storm-11","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#what-a-storm-scan-reports","content":"A re-identification risk score."},"168":{"id":"/docs/concepts/storm-12","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#what-a-storm-scan-reports","content":"That output is a JSON profile you can inspect, pipe to other tools, or use\ndirectly to decide which columns need which mask strategy."},"169":{"id":"/docs/concepts/storm-13","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#suggestions-not-classification","content":"STORM's detectors are heuristics: pattern matches, name hints, and\nnamed-entity recognition. They can miss a column that is actually sensitive\n(a false negative) and they can flag a column that isn't (a false positive).\nSTORM does not mask, redact, or transform anything itself, and it does not\napply a pipeline on your behalf. A column the scan flags as `ssn` still\ncontains SSNs in the clear until a masking step in your YAML explicitly\nhandles it."},"170":{"id":"/docs/concepts/storm-14","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#suggestions-not-classification","content":"This is a deliberate design stance, not a current limitation waiting on a\nfuture release. Decoy does not ship an auto-detect-and-apply pipeline where\nthe tool decides what a column is and masks it without you looking. STORM\nsurfaces candidates; you review them and decide."},"171":{"id":"/docs/concepts/storm-15","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#how-a-finding-becomes-a-choice","content":"The intended flow is scan, then review, then write:"},"172":{"id":"/docs/concepts/storm-16","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#how-a-finding-becomes-a-choice","content":"`decoy storm analyze data.csv` produces a profile."},"173":{"id":"/docs/concepts/storm-17","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#how-a-finding-becomes-a-choice","content":"You read the profile (or a colleague does) and decide, per column, which\ndetector hit is correct and which mask strategy fits it."},"174":{"id":"/docs/concepts/storm-18","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#how-a-finding-becomes-a-choice","content":"You write those decisions into the pipeline YAML as explicit\n`strategy:` entries."},"175":{"id":"/docs/concepts/storm-19","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#how-a-finding-becomes-a-choice","content":"`decoy storm integrity` can check the resulting masked output against the\nfindings you cared about, and exits with a findings-specific code (see\nexit codes) if something you expected to be\nmasked still shows up."},"176":{"id":"/docs/concepts/storm-20","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#how-a-finding-becomes-a-choice","content":"A Disguise template (see disguises) is a\nconvenient starting point built from common findings for a given\nregulation, but picking one is still something you do by hand; it is not\nsomething a scan chooses for you."},"177":{"id":"/docs/concepts/storm-21","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#why-this-matters-for-trust","content":"A tool that silently classifies and masks data makes it hard to know what it\nactually did to your dataset. Keeping detection and masking as two separate,\ninspectable steps means every masked output traces back to an explicit\ndecision you can find in the YAML, not a model's guess you have to take on\nfaith."},"178":{"id":"/docs/concepts/storm-22","page_id":"/docs/concepts/storm","tags":[],"type":"text","url":"/docs/concepts/storm#why-this-matters-for-trust","content":"See `decoy explain storm` for the command-line summary and\n`decoy storm analyze --help` for the full flag set."},"179":{"id":"/docs/how-to/choose-a-masking-strategy","page_id":"/docs/how-to/choose-a-masking-strategy","type":"page","content":"Choose a masking strategy","breadcrumbs":["Documentation","Guides","Discover and mask sensitive data"],"tags":[],"url":"/docs/how-to/choose-a-masking-strategy"},"180":{"id":"/docs/how-to/choose-a-masking-strategy-0","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy","content":"Pick the right strategy for each column."},"181":{"id":"/docs/how-to/choose-a-masking-strategy-1","page_id":"/docs/how-to/choose-a-masking-strategy","type":"heading","tags":[],"url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"By what you need"},"182":{"id":"/docs/how-to/choose-a-masking-strategy-2","page_id":"/docs/how-to/choose-a-masking-strategy","type":"heading","tags":[],"url":"/docs/how-to/choose-a-masking-strategy#keyed-vs-one-way","content":"Keyed vs one-way"},"183":{"id":"/docs/how-to/choose-a-masking-strategy-3","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy","content":"Start from what the column is and what you need to keep. Scan for\nPII first to see what is sensitive, then pick a\nstrategy per field. For a regulated dataset, a disguise\ngives you a reviewed starting point you can adjust."},"184":{"id":"/docs/how-to/choose-a-masking-strategy-4","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"You need"},"185":{"id":"/docs/how-to/choose-a-masking-strategy-5","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"Use"},"186":{"id":"/docs/how-to/choose-a-masking-strategy-6","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"Page"},"187":{"id":"/docs/how-to/choose-a-masking-strategy-7","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"Keep it joinable, not readable"},"188":{"id":"/docs/how-to/choose-a-masking-strategy-8","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"`hash`"},"189":{"id":"/docs/how-to/choose-a-masking-strategy-9","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"hash"},"190":{"id":"/docs/how-to/choose-a-masking-strategy-10","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"Keep the exact format (cards, SSNs)"},"191":{"id":"/docs/how-to/choose-a-masking-strategy-11","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"`fpe`"},"192":{"id":"/docs/how-to/choose-a-masking-strategy-12","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"fpe"},"193":{"id":"/docs/how-to/choose-a-masking-strategy-13","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking-strategy#by-what-you-need","content":"A realistic replacement"},"194":{"id":"/docs/how-to/choose-a-masking-strategy-14","page_id":"/docs/how-to/choose-a-masking-strategy","tags":[],"type":"text","url":"/docs/how-to/choose-a-masking