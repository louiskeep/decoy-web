<section class="hero hero--page">
  <div class="container">
    <div class="hero-copy">
      <p class="eyebrow">Pricing</p>
      <h1>Priced per instance, not per row</h1>
      <p class="lede">The CLI is free. The Platform is one flat price per self-hosted instance. Nothing is metered by seat, row, column, or connector.</p>
    </div>
  </div>
</section>

<section class="section section--tight" id="plans">
  <div class="container">
    <div class="plans">
      <div class="plan">
        <div class="plan-name">{{ site.products.cli }}</div>
        <div class="plan-price">$0</div>
        <div class="plan-meta">Free and source-available (BUSL-1.1). The full engine, on your machine.</div>
        <ul>
          <li>{% icon "check" %} 23 masking strategies</li>
          <li>{% icon "check" %} 12 generation types, 34 providers</li>
          <li>{% icon "check" %} FK-aware subsetting</li>
          <li>{% icon "check" %} PII scan, 25 detectors</li>
          <li>{% icon "check" %} 10 Disguise templates</li>
          <li>{% icon "check" %} Evidence manifests, JSON reports, stable exit codes</li>
          <li>{% icon "check" %} Community support on GitHub</li>
        </ul>
        <a class="btn btn--secondary prelaunch-only" href="mailto:{{ site.contacts.support }}?subject=Notify%20me%20when%20Decoy%20launches">Get notified</a>
        <a class="btn btn--secondary launch-only" href="/cli/#install">Download</a>
      </div>
      <div class="plan plan--featured">
        <div class="plan-name">{{ site.products.platform }}</div>
        <div class="plan-price">${{ site.pricing.platformMonthly }}<small>/month per instance</small></div>
        <div class="plan-meta">Billed annually ($5,988/year). One instance is one deployment.</div>
        <ul>
          <li>{% icon "check" %} Everything in the CLI</li>
          <li>{% icon "check" %} {{ site.products.builder }} visual builder and shared job history</li>
          <li>{% icon "check" %} API and webhook triggers for your scheduler</li>
          <li>{% icon "check" %} Four roles, OIDC single sign-on, API keys</li>
          <li>{% icon "check" %} Hash-chained audit log with CSV and JSON export</li>
          <li>{% icon "check" %} S3-compatible, GCS, and Postgres sources</li>
          <li>{% icon "check" %} Email, Slack, and webhook alerts</li>
          <li>{% icon "check" %} Email support, business hours</li>
        </ul>
        <a class="btn btn--primary" href="mailto:{{ site.contacts.sales }}?subject=Decoy%20Platform">Talk to us</a>
      </div>
      <div class="plan">
        <div class="plan-name">Enterprise</div>
        <div class="plan-price">Custom</div>
        <div class="plan-meta">For organisations running several instances or with contractual requirements.</div>
        <ul>
          <li>{% icon "check" %} One instance per environment (dev, staging, prod), priced together</li>
          <li>{% icon "check" %} BAA, DPA, SLA, and security review negotiated in contract</li>
          <li>{% icon "check" %} Named contact and onboarding help</li>
          <li>{% icon "check" %} Custom terms</li>
        </ul>
        <a class="btn btn--secondary" href="mailto:{{ site.contacts.sales }}?subject=Decoy%20Enterprise">Contact us</a>
      </div>
    </div>
  </div>
</section>

