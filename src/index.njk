        <div class="plan-price">$0</div>
        <div class="plan-meta">Free and source-available. The full engine, locally.</div>
        <a class="btn btn--secondary" href="/cli/">What the CLI does</a>
      </div>
      <div class="plan plan--featured">
        <div class="plan-name">{{ site.products.platform }}</div>
        <div class="plan-price">${{ site.pricing.platformMonthly }}<small>/month per instance</small></div>
        <div class="plan-meta">Billed annually. No seats, no row counts, no connector fees.</div>
        <a class="btn btn--primary" href="/pricing/">See pricing</a>
      </div>
    </div>
  </div>
</section>

