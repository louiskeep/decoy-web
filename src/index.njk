<section class="hero hero--split">
  <div class="container">
    <div class="hero-copy">
      <p class="eyebrow">Data masking and synthetic data</p>
      <h1 data-split>Production-<br class="br-wide">shaped data.<br class="br-wide">None of the risk.</h1>
      <p class="lede">Decoy masks, generates, and subsets your data so every environment gets realistic rows with joins intact and no PII. Deterministic by construction, explicit in YAML, and run entirely on your own machines.</p>
      <div class="hero-actions">
        <a class="btn btn--primary btn--lg prelaunch-only" href="mailto:{{ site.contacts.support }}?subject=Notify%20me%20when%20Decoy%20launches">{% icon "mail" %} Get notified at launch</a>
        <a class="btn btn--primary btn--lg launch-only" href="/cli/#install">{% icon "download" %} Download the CLI</a>
        <a class="btn btn--secondary btn--lg" href="/how-it-works/">How it works {% icon "arrow-right" %}</a>
        <span class="small muted">Free CLI, source-available. Platform from ${{ site.pricing.platformMonthly }}/month per instance.</span>
      </div>
    </div>
    <div class="frame hero-visual" data-hero-mask aria-label="Example of a customer table before and after masking">
      <div class="terminal-bar"><i></i><i></i><i></i><span>customers.parquet · 2 of 23 strategies</span></div>
