          <tr class="mask-before"><td class="key">10483</td><td class="raw" data-safe="arjun.malik@example.org">d.nakamura@example.org</td><td class="raw" data-safe="145-73-8816">308-19-2210</td><td class="raw" data-safe="1992-11-19">1992-11-02</td></tr>
          <tr class="mask-before"><td class="key">10484</td><td class="raw" data-safe="sofia.lind@example.net">kwame.a@example.net</td><td class="raw" data-safe="462-05-3190">771-62-0048</td><td class="raw" data-safe="1979-07-14">1979-07-30</td></tr>
          <tr><td colspan="4" class="faint" data-caption style="white-space: normal">decoy run pipeline.yaml &nbsp;·&nbsp; email: faker &nbsp;·&nbsp; ssn: fpe &nbsp;·&nbsp; dob: date_shift</td></tr>
