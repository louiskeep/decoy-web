<section class="section section--tight">
  <div class="container">
    <div class="frame">
      <img src="/images/decoy/studio-builder.webp" alt="Job Studio: the visual pipeline builder in Decoy Platform" width="1600" height="900" loading="eager">
    </div>
  </div>
